# Copy to .env locally and fill only approved values. Never commit .env.
APP_ENV=local
SERVICE_ROLE=application
DATABASE_URL=
POSTGRES_PASSWORD=
API_BASE_URL=http://api:8000
OPERATOR_ACCESS_TOKEN=

# Required only when Docker Compose builds application images. Generate these from
# committed Docker inputs with scripts/build_context_manifest.py; never invent values.
SOURCE_MANIFEST_SHA256=
SOURCE_CANDIDATE_ID=

# M0 defaults to isolated mock boundaries. Live modes require Human-provisioned credentials.
GMAIL_TRANSPORT=mock
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_MAILBOX_ADDRESS=
GMAIL_LABEL_NAME=Sales Leads
GMAIL_POLL_INTERVAL_SECONDS=

LLM_TRANSPORT=mock
# Live mode currently supports DeepSeek's OpenAI-compatible Chat Completions boundary.
LLM_PROVIDER=deepseek
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MAX_INPUT_CHARS=
LLM_TIMEOUT_SECONDS=
LLM_RETRY_MAX=

FOLLOW_UP_SCAN_INTERVAL_SECONDS=
LOG_LEVEL=info
OPERATOR_ACCESS_MODE=private-host-only
